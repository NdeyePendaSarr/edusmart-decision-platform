# =============================================================================
# EduSmart Decision Platform — Variables d'environnement
# 1. Copier ce fichier en docker/.env
# 2. Remplacer TOUS les mots de passe « change_me_... »
# 3. Ne JAMAIS versionner docker/.env (déjà exclu par .gitignore)
# Ce fichier est lu par Docker Compose ET par common/config.py.
# Pas de commentaire en fin de ligne : Docker Compose l'inclurait dans la valeur.
# =============================================================================

# --- Général -----------------------------------------------------------------
TZ=Africa/Dakar
# Graine globale : garantit des données reproductibles
EDUSMART_SEED=2026
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Source 1 : PostgreSQL « Gestion académique » -----------------------------
PG_SOURCE_HOST=localhost
PG_SOURCE_PORT=5435
PG_SOURCE_DB=edusmart_academic
PG_SOURCE_USER=edusmart
PG_SOURCE_PASSWORD=change_me_pg_source

# --- Data Warehouse : PostgreSQL ---------------------------------------------
PG_DW_HOST=localhost
PG_DW_PORT=5434
PG_DW_DB=edusmart_dw
PG_DW_USER=edusmart_dw
PG_DW_PASSWORD=change_me_pg_dw

# --- Source 2 : MySQL « Plateforme pédagogique » ------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DB=edusmart_learning
MYSQL_USER=edusmart
MYSQL_PASSWORD=change_me_mysql
MYSQL_ROOT_PASSWORD=change_me_mysql_root

# --- Source 4 : MongoDB « Journaux de l'application mobile » ------------------
MONGO_HOST=localhost
MONGO_PORT=27018
MONGO_DB=edusmart_mobile
MONGO_ROOT_USER=edusmart
MONGO_ROOT_PASSWORD=change_me_mongo

# --- Source 5 : Redis « Plateforme temps réel » -------------------------------
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=change_me_redis

# --- Outils ------------------------------------------------------------------
ADMINER_PORT=8081
